datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String  @unique
  name  String
  image String?

  teams   Team[]   @relation(fields: [teamIds], references: [id])
  teamIds String[] @default([]) @db.ObjectId

  timeLogs TimeLog[]

  slackUserId      String?
  dutyRole         DutyRole?
  attendanceExempt Boolean?

  attendanceMarks AttendanceMark[]
  wantedRecords   WantedRecord[]
  dutyAssignments DutyAssignment[]
}

enum TimeLogStatus {
  CurrentlyIn
  Done
  Locked
}

model TimeLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  status  TimeLogStatus
  inTime  DateTime
  outTime DateTime?
  notes   String?

  // Set when status is Locked; null on logs locked before these fields existed.
  lockReason TimeLogLockReason?
  lockedAt   DateTime?
  // Admin who locked the log; null for automatic locks and Admin API (API key) locks.
  lockedById String?            @db.ObjectId
}

enum TimeLogLockReason {
  AutoTimeout
  Admin
}

model Team {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  users   User[]   @relation(fields: [userIds], references: [id])
  userIds String[] @default([]) @db.ObjectId
}

enum StatRangeStatus {
  Active
  Archived
}

model StatRange {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  startDate DateTime
  endDate   DateTime
  status    StatRangeStatus @default(Active)
}

// Calendar days are `YYYY-MM-DD` strings in `TZ`, so they never shift with a viewer's time zone.

enum DutyRole {
  CE
  PM
  MACHINING
}

model AttendanceSeason {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  startDate String
  endDate   String
}

model SeasonEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  startDate String
  endDate   String?
  notes     String?
}

model AttendanceMark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  date String

  @@unique([userId, date])
  @@index([date])
}

model WantedRecord {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  weekStart String

  @@unique([userId, weekStart])
}

model DutyAssignment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  date String
  role DutyRole

  @@unique([userId, date])
  @@index([date])
}
