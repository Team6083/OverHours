datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String  @unique
  name  String
  image String?

  // Identity provider accounts this user signs in with. Users are matched by these, not by email,
  // so changing the email at the provider keeps the same user.
  accounts Account[]

  teams   Team[]   @relation(fields: [teamIds], references: [id])
  teamIds String[] @default([]) @db.ObjectId
  // The teams in `teamIds` the user joined because of a Keycloak role (Team.autoJoinRoles). They leave
  // these when they lose the role; other memberships were added by hand and stay.
  roleTeamIds String[] @default([]) @db.ObjectId

  timeLogs TimeLog[]

  attendanceEntries AttendanceEntry[]
  // The member's usual week, applied to the week form on request. Weekdays not listed have no usual answer.
  attendancePattern AttendancePatternDay[]
}

type AttendancePatternDay {
  // 0 = Monday … 6 = Sunday
  weekday Int
  status  AttendanceStatus
}

// An identity provider (OIDC) account linked to a user, identified by the Auth.js provider id and `sub`
// (like Auth.js adapters). Not by issuer URL: Keycloak keeps `sub` when its hostname or realm name changes,
// so keying on the URL would lock everyone out after such a change.
model Account {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  provider String
  subject  String
  // Last seen `iss`, for reference only.
  issuer   String
  // Email the provider reported at the last sign-in.
  email    String

  @@unique([provider, subject])
  @@index([userId])
}

enum TimeLogStatus {
  CurrentlyIn
  Done
  Locked
}

model TimeLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  status  TimeLogStatus
  inTime  DateTime
  outTime DateTime?
  notes   String?

  // Set when status is Locked; null on logs locked before these fields existed.
  lockReason TimeLogLockReason?
  lockedAt   DateTime?
  // Admin who locked the log; null for automatic locks and Admin API (API key) locks.
  lockedById String?            @db.ObjectId
}

enum TimeLogLockReason {
  AutoTimeout
  Admin
}

model Team {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  // Teams form a tree. Deleting a team that still has sub-teams is refused in code.
  parentTeam   Team?   @relation("TeamToSubTeams", fields: [parentTeamId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  parentTeamId String? @db.ObjectId
  subTeams     Team[]  @relation("TeamToSubTeams")

  users   User[]   @relation(fields: [userIds], references: [id])
  userIds String[] @default([]) @db.ObjectId

  // Users with any of these roles join the team automatically. Same syntax as ADMIN_ROLES: realm roles
  // as-is, client roles as `client:role`.
  autoJoinRoles String[] @default([])
}

// A team's reminder. The admin page edits one "unanswered" rule per team; the model leaves room for more rules,
// conditions and channels without a schema change.
model ReminderRule {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId   String  @db.ObjectId
  enabled  Boolean @default(false)
  // Checked with zod per kind; only "unanswered" ({ weekdays, daysAhead }) for now
  kind     String
  config   Json
  // `HH:mm` in `TZ`
  sendTime String
  // Checked with zod per channel; only "slack-webhook" ({ url? }) for now. Never sent to the browser.
  channel  String
  target   Json

  @@index([teamId])
}

// One row per rule and run, inserted to claim the run so it goes out once.
model ReminderDelivery {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  ruleId String   @db.ObjectId
  // The date (`YYYY-MM-DD` in `TZ`) for a daily rule
  runKey String
  // "claimed" while sending, then "sent" or "nobodyMissing"
  result String
  sentAt DateTime @default(now())

  @@unique([ruleId, runKey])
}

enum StatRangeStatus {
  Active
  Archived
}

model StatRange {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  startDate DateTime
  endDate   DateTime
  status    StatRangeStatus @default(Active)
}

// WillCome: promised to be there. Available: if needed. No row means not filled in.
enum AttendanceStatus {
  WillCome
  Available
  Unavailable
}

// Only AllDay is used for now; more values can split a day into time slots.
enum AttendanceSlot {
  AllDay
}

// No row for a day means the user has not filled it in.
model AttendanceEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  // `YYYY-MM-DD` in `TZ`, so a day never shifts with a viewer's time zone.
  date   String
  slot   AttendanceSlot   @default(AllDay)
  status AttendanceStatus

  @@unique([userId, date, slot])
  @@index([date])
}
