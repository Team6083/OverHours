datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String  @unique
  name  String
  image String?

  // Keycloak `sub` of the account this user signs in with; null until the user first signs in
  // (e.g. created by an admin). Users are matched by this, not by email, so changing the email in
  // Keycloak keeps the same user. Not @unique: Prisma's MongoDB unique index is not sparse, so
  // existing users without it would collide; linkKeycloakUser keeps it unique instead.
  keycloakId String?

  @@index([keycloakId])

  teams   Team[]   @relation(fields: [teamIds], references: [id])
  teamIds String[] @default([]) @db.ObjectId

  timeLogs TimeLog[]

  attendanceEntries AttendanceEntry[]
}

enum TimeLogStatus {
  CurrentlyIn
  Done
  Locked
}

model TimeLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  status  TimeLogStatus
  inTime  DateTime
  outTime DateTime?
  notes   String?

  // Set when status is Locked; null on logs locked before these fields existed.
  lockReason TimeLogLockReason?
  lockedAt   DateTime?
  // Admin who locked the log; null for automatic locks and Admin API (API key) locks.
  lockedById String?            @db.ObjectId
}

enum TimeLogLockReason {
  AutoTimeout
  Admin
}

model Team {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  users   User[]   @relation(fields: [userIds], references: [id])
  userIds String[] @default([]) @db.ObjectId
}

enum StatRangeStatus {
  Active
  Archived
}

model StatRange {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  startDate DateTime
  endDate   DateTime
  status    StatRangeStatus @default(Active)
}

enum AttendanceStatus {
  Available
  Unavailable
}

// Only AllDay is used for now; more values can split a day into time slots.
enum AttendanceSlot {
  AllDay
}

// No row for a day means the user has not filled it in.
model AttendanceEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  // `YYYY-MM-DD` in `TZ`, so a day never shifts with a viewer's time zone.
  date   String
  slot   AttendanceSlot   @default(AllDay)
  status AttendanceStatus

  @@unique([userId, date, slot])
  @@index([date])
}
